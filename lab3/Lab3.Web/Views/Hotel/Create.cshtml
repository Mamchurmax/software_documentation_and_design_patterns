@model Lab2.Domain.Entities.Hotel

@{
    ViewData["Title"] = "Create Hotel";
}

<h2>Create Hotel</h2>
<hr style="border-color: rgba(255,255,255,0.2);" />

<div class="row mt-4">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label">Hotel Name</label>
                <input asp-for="Name" class="form-control form-control-glass" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StarRating" class="form-label">Star Rating (1-5)</label>
                <input asp-for="StarRating" type="number" min="1" max="5" class="form-control form-control-glass" required />
                <span asp-validation-for="StarRating" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control form-control-glass" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-4 form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                </label>
            </div>

            <div class="form-group d-flex gap-2">
                <input type="submit" value="Create" class="btn btn-primary-glass" />
                <a asp-action="Index" class="btn btn-glass">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
