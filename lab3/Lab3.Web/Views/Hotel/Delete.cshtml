@model Lab2.Domain.Entities.Hotel

@{
    ViewData["Title"] = "Delete Hotel";
}

<div class="alert alert-danger mb-4" style="background: rgba(220,53,69,0.2); border-color: rgba(220,53,69,0.3); color: white;">
    <h4 class="alert-heading">Are you sure you want to delete this hotel?</h4>
    <p class="mb-0">This action cannot be undone and will remove all associated rooms and reviews.</p>
</div>

<div class="glass-card p-4">
    <h3 class="mb-4">@Html.DisplayFor(model => model.Name)</h3>
    <dl class="row mb-0">
        <dt class="col-sm-3 text-white-50">Location</dt>
        <dd class="col-sm-9">@(Model.Location?.City), @(Model.Location?.Country)</dd>
        
        <dt class="col-sm-3 text-white-50">Star Rating</dt>
        <dd class="col-sm-9">
            <span class="text-warning">
                @for(int i=0; i<Model.StarRating; i++){ <text>★</text> }
            </span>
        </dd>
    </dl>
</div>

<div class="mt-4">
    <form asp-action="Delete">
        <input type="hidden" asp-for="PropertyId" />
        <input type="submit" value="Yes, Delete it" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-glass ms-2">Cancel</a>
    </form>
</div>

@section Scripts {
    <script>
        if (typeof firebase !== 'undefined') {
            firebase.analytics().logEvent('hotel_delete_view', {
                hotel_name: '@Model?.Name',
                hotel_id: '@Model?.PropertyId'
            });
            document.querySelector('form')?.addEventListener('submit', function() {
                firebase.analytics().logEvent('hotel_delete_confirm', {
                    hotel_name: '@Model?.Name',
                    hotel_id: '@Model?.PropertyId'
                });
            });
        }
    </script>
}
